# =====================================================================================
# NEXUS - example environment file
# =====================================================================================
# Copy this file to `.env` and fill in real values:
#
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
#
# `.env` is listed in .gitignore. NEVER commit real secrets - git history is forever.
#
# Variable names follow the settings tree in app/core/config.py:
#   NEXUS_<GROUP>__<FIELD>   maps to settings.<group>.<field>
# =====================================================================================

# -------------------------------------------------------------------------------------
# Core
# -------------------------------------------------------------------------------------
# local  = SQLite + in-process jobs + in-memory mail  (no Docker required)
# docker = PostgreSQL + Redis/RQ + Mailpit            (see docker-compose.yml)
NEXUS_PROFILE=local
NEXUS_ENVIRONMENT=development
NEXUS_LOG_LEVEL=INFO
# console = human readable, json = one object per line (use json in containers)
NEXUS_LOG_FORMAT=console

# -------------------------------------------------------------------------------------
# Secrets  (REQUIRED - generate your own, do not reuse these shapes)
# -------------------------------------------------------------------------------------
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
NEXUS_SECRET_KEY=replace-with-a-random-string-of-at-least-32-characters

# API key for every /api/v1 request, sent as the X-API-Key header.
# Leave empty ONLY for local development. The server logs a warning when it is empty.
NEXUS_API_KEY=replace-with-a-random-string-of-at-least-16-characters

# Encrypts proxy credentials at rest. Without it, NEXUS refuses to store a proxy that has a
# password rather than keeping the password in plain text.
NEXUS_PROXY_CREDENTIAL_KEY=replace-with-another-random-string

# -------------------------------------------------------------------------------------
# Database
# -------------------------------------------------------------------------------------
# local profile:
NEXUS_DATABASE__URL=sqlite+aiosqlite:///./nexus.db
# docker profile (matches docker-compose.yml; note the +asyncpg driver):
# NEXUS_DATABASE__URL=postgresql+asyncpg://nexus:nexus@127.0.0.1:5432/nexus
NEXUS_DATABASE__ECHO=false
NEXUS_DATABASE__POOL_SIZE=5
NEXUS_DATABASE__MAX_OVERFLOW=10

# -------------------------------------------------------------------------------------
# HTTP API
# -------------------------------------------------------------------------------------
# Keep 127.0.0.1 for local work: it means the API is not reachable from your network.
NEXUS_API__HOST=127.0.0.1
NEXUS_API__PORT=8000
NEXUS_API__DOCS_ENABLED=true
# JSON array. Empty means no cross-origin access at all (the safe default).
NEXUS_API__CORS_ORIGINS=[]

# -------------------------------------------------------------------------------------
# Outbound network safety  (see docs/SECURITY.md)
# -------------------------------------------------------------------------------------
NEXUS_NETWORK__HTTP_TIMEOUT_SECONDS=15
NEXUS_NETWORK__MAX_CONCURRENT_CHECKS=10
NEXUS_NETWORK__MAX_RESPONSE_BYTES=1048576

# Development-only escape hatch. Allows the SSRF guard to reach private addresses so you can
# test against 127.0.0.1. MUST stay false anywhere but your own machine - it is refused outright
# in the production profile.
NEXUS_NETWORK__ALLOW_PRIVATE_TARGETS=false

# Deny-by-default allowlist of registration target hosts, as a JSON array.
# Empty means ONLY the bundled demonstration application may be used.
# Add a host only for an application you own or are explicitly authorized to test.
NEXUS_NETWORK__ALLOWED_TARGET_HOSTS=[]

# -------------------------------------------------------------------------------------
# Test mail backend
# -------------------------------------------------------------------------------------
# memory  = messages stay in-process (offline work and tests)
# mailpit = real SMTP delivery into Mailpit (local or docker)
NEXUS_MAIL__BACKEND=memory
NEXUS_MAIL__SMTP_HOST=127.0.0.1
NEXUS_MAIL__SMTP_PORT=1025
NEXUS_MAIL__API_URL=http://127.0.0.1:8025
# RFC 2606/6761 reserved domain: cannot receive real mail, which is exactly why it is the default.
NEXUS_MAIL__RESERVED_DOMAIN=example.test

# -------------------------------------------------------------------------------------
# Background jobs
# -------------------------------------------------------------------------------------
# inprocess = run jobs inside the API process (local profile)
# rq        = Redis-backed workers (Phase 5)
NEXUS_JOBS__BACKEND=inprocess
NEXUS_JOBS__REDIS_URL=redis://127.0.0.1:6379/0
NEXUS_JOBS__QUEUE_NAME=nexus
NEXUS_JOBS__MAX_WORKERS=2
